+/// Load the exact production verifying key. Verification fails closed if the key is missing,
+/// corrupt, or belongs to a different ceremony. A verifier must never silently generate a new
+/// key because that creates a statement domain incompatible with previously issued proofs.
+fn load_vk_from_path(
+    path: &Path,
+) -> Result<ark_groth16::PreparedVerifyingKey<ark_bn254::Bn254>, String> {
+    let vk_data = std::fs::read(path)
+        .map_err(|error| format!("failed to read verifying key {}: {error}", path.display()))?;
+    let vk = ark_groth16::VerifyingKey::<ark_bn254::Bn254>::deserialize_compressed(&vk_data[..])
+        .map_err(|error| format!("invalid verifying key {}: {error}", path.display()))?;
+    Ok(ark_groth16::prepare_verifying_key(&vk))
+}
+
+fn load_production_vk() -> Result<ark_groth16::PreparedVerifyingKey<ark_bn254::Bn254>, String> {
+    load_vk_from_path(Path::new(VK_FILE))
 }
